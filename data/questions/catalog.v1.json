{
  "schema_version": "finbi.question-catalog.v1",
  "mission": "Map recurring financial questions to canonical data, calculations, scenarios, decisions, and provenance without duplicating primary-source authority.",
  "public_private_boundary": {
    "public_repository": true,
    "public_pages": "verified public or synthetic/sample observations only",
    "private_inputs": "local or connected private sources only; never commit account numbers, private transaction exports, tax documents, credentials, or personal identifiers"
  },
  "recipes": [
    {
      "question_id": "portfolio.current_state",
      "desk": "portfolio",
      "intent": "今のポートフォリオはどうか",
      "required_inputs": ["positions", "prices", "instrument_identity", "risk_factor_mapping"],
      "data_authority": ["broker/account source", "investor2 analytics"],
      "as_of_policy": "position and price timestamps must be explicit",
      "calculation": ["allocation", "factor overlap", "risk contribution", "concentration"],
      "comparison_or_scenario": ["current vs target", "current vs benchmark"],
      "decision_output": ["keep", "reduce", "increase", "investigate"],
      "risk_output": ["volatility", "max_drawdown", "risk_contribution"],
      "provenance_output": ["source", "as_of", "valuation_method"],
      "freshness_requirement": "current account state for execution decisions",
      "failure_mode": "UNVERIFIED when holdings or prices are stale/incomplete"
    },
    {
      "question_id": "portfolio.what_to_buy_sell",
      "desk": "portfolio",
      "intent": "何を買う / 売る / 何%追加する",
      "required_inputs": ["current portfolio", "constraints", "expected_return_model", "covariance_model"],
      "data_authority": ["investor2 analytics", "broker/account source"],
      "as_of_policy": "all optimization inputs disclose window and as-of",
      "calculation": ["marginal risk", "turnover", "allocation delta"],
      "comparison_or_scenario": ["0/2/5/10/20% add", "same-return min-vol", "min-variance", "max-Sharpe"],
      "decision_output": ["recommended comparison band", "no-trade"],
      "risk_output": ["volatility", "Sharpe", "max_drawdown", "risk contribution"],
      "provenance_output": ["input window", "constraints", "model version"],
      "freshness_requirement": "portfolio snapshot must match decision date",
      "failure_mode": "NO_DECISION when optimization is sample-dominated or inputs are incomplete"
    },
    {
      "question_id": "portfolio.efficient_frontier",
      "desk": "frontier-lab",
      "intent": "効率的フロンティア / 各資産のrisk-return / 新資産追加効果",
      "required_inputs": ["aligned return series", "constraints"],
      "data_authority": ["investor2 analytics", "market provider"],
      "as_of_policy": "common observation window required",
      "calculation": ["annualized return", "Ledoit-Wolf covariance", "frontier optimization"],
      "comparison_or_scenario": ["before vs after asset inclusion", "allocation caps"],
      "decision_output": ["frontier improves", "frontier unchanged", "frontier worsens"],
      "risk_output": ["model volatility", "realized volatility", "max_drawdown"],
      "provenance_output": ["window", "frequency", "annualization", "proxy/executable distinction"],
      "freshness_requirement": "not necessarily live; reproducible common window is mandatory",
      "failure_mode": "REJECT comparison when windows/frequencies differ silently"
    },
    {
      "question_id": "asset.compare",
      "desk": "products",
      "intent": "株式・債券・ETF・投信・MMF・MRF・定期預金などを比較する",
      "required_inputs": ["return/yield", "risk", "fees", "tax", "currency exposure", "liquidity"],
      "data_authority": ["issuer", "broker", "bank", "market provider"],
      "as_of_policy": "current product terms must be current-verified",
      "calculation": ["net yield", "fee drag", "FX sensitivity", "scenario return"],
      "comparison_or_scenario": ["same capital", "same risk budget", "same horizon"],
      "decision_output": ["best fit by objective", "not comparable"],
      "risk_output": ["market risk", "FX risk", "duration", "liquidity risk"],
      "provenance_output": ["official product terms", "effective date"],
      "freshness_requirement": "current official terms",
      "failure_mode": "UNVERIFIED when fee/rate/product term is stale"
    },
    {
      "question_id": "fx.carry_leverage",
      "desk": "fx-desk",
      "intent": "USDJPYの1x/2x/3x等、swap、金利差、固定建玉、ロスカットを評価する",
      "required_inputs": ["USDJPY", "swap", "margin rules", "policy/overnight rates"],
      "data_authority": ["broker", "central bank", "market provider"],
      "as_of_policy": "current swap and margin terms timestamped separately from historical backtest",
      "calculation": ["carry", "effective leverage", "margin buffer", "fixed-notional wealth", "constant-leverage factor"],
      "comparison_or_scenario": ["FX move stress", "broker comparison", "fixed-notional vs reset leverage"],
      "decision_output": ["position size band", "avoid", "macro-only allocation"],
      "risk_output": ["FX sensitivity", "liquidation distance", "drawdown", "leverage drift"],
      "provenance_output": ["broker rule date", "swap date", "rate sources", "backtest window"],
      "freshness_requirement": "same-day/most-recent broker terms for execution",
      "failure_mode": "REJECT when monthly-average data is presented as executable daily risk"
    },
    {
      "question_id": "rates.bonds",
      "desk": "rates-desk",
      "intent": "政策金利・国債・実質金利・イールドカーブ・債券代替を評価する",
      "required_inputs": ["policy rates", "yield curve", "real yields", "duration"],
      "data_authority": ["central bank", "government/official statistics", "verified snapshot"],
      "as_of_policy": "point-in-time availability must be preserved",
      "calculation": ["bp move", "curve spread", "duration sensitivity", "real yield"],
      "comparison_or_scenario": ["2s10s", "bond vs earnings yield", "rate shock"],
      "decision_output": ["steepen/flatten", "bond attractiveness context"],
      "risk_output": ["duration loss", "rate sensitivity"],
      "provenance_output": ["vintage", "retrieved_at", "source availability"],
      "freshness_requirement": "depends on question; current for trade, PIT for historical comparison",
      "failure_mode": "FAIL_CLOSE without source availability evidence"
    },
    {
      "question_id": "valuation.growth",
      "desk": "valuation",
      "intent": "PER・益利回り・EPS CAGR・実需成長を比較する",
      "required_inputs": ["price", "forward/trailing EPS", "growth history/estimates"],
      "data_authority": ["index provider", "company IR", "consensus source"],
      "as_of_policy": "estimate vintage and realized period must be explicit",
      "calculation": ["earnings yield", "EPS CAGR", "growth-adjusted comparison"],
      "comparison_or_scenario": ["index vs bonds", "historical valuation bands", "realized vs forecast growth"],
      "decision_output": ["valuation supportive", "valuation restrictive", "indicator not decision-useful alone"],
      "risk_output": ["multiple compression sensitivity"],
      "provenance_output": ["estimate source", "revision history", "price date"],
      "freshness_requirement": "latest available estimates for current valuation",
      "failure_mode": "DO_NOT infer current valuation from stale EPS vintage"
    },
    {
      "question_id": "macro.regime",
      "desk": "macro",
      "intent": "インフレ・雇用・PMI・M2・流動性から市場レジームを読む",
      "required_inputs": ["inflation", "labor", "growth surveys", "money/liquidity", "rates"],
      "data_authority": ["official statistics", "econalert"],
      "as_of_policy": "release date and revision vintage required",
      "calculation": ["change", "surprise", "real rate", "liquidity growth"],
      "comparison_or_scenario": ["prior release", "consensus", "historical regime"],
      "decision_output": ["risk-on/off context", "no portfolio change", "investigate exposure"],
      "risk_output": ["rate/FX/equity transmission"],
      "provenance_output": ["release", "vintage", "revision"],
      "freshness_requirement": "latest release for current regime",
      "failure_mode": "UNVERIFIED when headline and release/vintage conflict"
    },
    {
      "question_id": "event.portfolio_impact",
      "desk": "event-lens",
      "intent": "ニュースが本当か、何に効き、ポートフォリオを変えるべきか",
      "required_inputs": ["event facts", "affected companies/assets", "current exposures", "market reaction"],
      "data_authority": ["primary disclosure", "trusted news", "portfolio source"],
      "as_of_policy": "event time, publication time, and market response window explicit",
      "calculation": ["exposure mapping", "price reaction", "scenario impact"],
      "comparison_or_scenario": ["before/after event", "base/upside/downside"],
      "decision_output": ["act", "watch", "ignore"],
      "risk_output": ["portfolio contribution under scenario"],
      "provenance_output": ["primary source", "news source", "market timestamps"],
      "freshness_requirement": "current when event is active",
      "failure_mode": "NO_ACTION when facts are unconfirmed"
    },
    {
      "question_id": "backtest.strategy",
      "desk": "backtest-lab",
      "intent": "戦略の実績・レジーム・開始時点感応度・最大DDを再現する",
      "required_inputs": ["price/return series", "strategy mechanics", "cost/carry assumptions"],
      "data_authority": ["market provider", "strategy repository"],
      "as_of_policy": "full sample and holdout boundaries explicit",
      "calculation": ["CAGR", "arithmetic mean", "volatility", "Sharpe", "max drawdown", "rolling windows"],
      "comparison_or_scenario": ["multiple start dates", "regime splits", "cost assumptions"],
      "decision_output": ["robust", "regime-dependent", "reject"],
      "risk_output": ["drawdown", "tail loss", "parameter sensitivity"],
      "provenance_output": ["data window", "mechanics", "assumptions", "code version"],
      "freshness_requirement": "reproducibility over recency",
      "failure_mode": "REJECT single favorable-window evidence"
    },
    {
      "question_id": "tax.cashflow",
      "desk": "tax-cashflow",
      "intent": "予定納税・ふるさと納税・給与/副業/事業所得・NISA/iDeCo・法人化を試算する",
      "required_inputs": ["income", "deductions", "tax rules", "cashflow assumptions"],
      "data_authority": ["official tax authority", "kakeibo/private user inputs"],
      "as_of_policy": "tax year and law effective date required",
      "calculation": ["taxable income", "deductions", "tax estimate", "cashflow impact"],
      "comparison_or_scenario": ["income scenarios", "deduction scenarios", "individual vs corporation"],
      "decision_output": ["estimated range", "required follow-up input", "professional-review flag"],
      "risk_output": ["underpayment/overpayment sensitivity"],
      "provenance_output": ["tax year", "law source", "input status"],
      "freshness_requirement": "current tax-year rules",
      "failure_mode": "ESTIMATE_ONLY when user income/deductions are incomplete"
    },
    {
      "question_id": "audit.revision",
      "desk": "audit",
      "intent": "その数値を信じてよいか、改定履歴・出典・前提を監査する",
      "required_inputs": ["claim", "source", "timestamp", "revision history"],
      "data_authority": ["primary source", "versioned observations"],
      "as_of_policy": "claim must be evaluated at the claimed as-of",
      "calculation": ["cross-check", "revision delta", "consistency checks"],
      "comparison_or_scenario": ["original vs revised", "source A vs source B"],
      "decision_output": ["VERIFIED", "PROXY", "ESTIMATE", "UNVERIFIED", "REJECT"],
      "risk_output": ["decision impact of revision"],
      "provenance_output": ["source URL", "retrieved_at", "vintage", "hash/version"],
      "freshness_requirement": "source-specific",
      "failure_mode": "FAIL_CLOSE on provenance conflict"
    }
  ]
}
